PORT=5000
MONGODB_URI=mongodb+srv://USER:PASS@CLUSTER.mongodb.net/construction
# At least 32 random characters, e.g. run: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=12h
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173
# Public URL of this API (used for local receipt links when Cloudinary is not configured)
PUBLIC_URL=http://localhost:5000
# Cloudinary (recommended for production). If empty, receipts are stored on local disk.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# First admin, created by `npm run seed`
ADMIN_NAME=Owner
ADMIN_PHONE=
ADMIN_PASSWORD=
APP_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Construction Manager <no-reply@example.com>
ADMIN_EMAIL=
